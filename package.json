{
  "name": "moltbot-easy",
  "version": "2026.9.1",
  "private": true,
  "description": "User-friendly desktop app for OpenClaw \u2014 bring your own AI provider key",
  "license": "Apache-2.0",
  "author": "ToniSan",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter ./apps/desktop dev",
    "build": "pnpm --filter ./packages/shared build && pnpm --filter ./apps/desktop build",
    "package": "pnpm --filter ./apps/desktop package",
    "test": "pnpm --filter ./apps/desktop test",
    "test:e2e": "pnpm --filter ./apps/desktop test:e2e",
    "lint": "pnpm --filter ./packages/shared --filter ./apps/desktop lint",
    "format": "pnpm --filter ./packages/shared --filter ./apps/desktop format"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037"
}
